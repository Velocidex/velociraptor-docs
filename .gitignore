**/.DS_Store
**/**/.DS_Store
public/
.wordlist.dict
.hugo_build.lock

# Hugo module checksum lock files. Module checksums are tracked in go.mod/
# go.sum, and Hugo rewrites these to empty on every build, so they are
# churn only.
hugo.direct.sum
hugo.sum

.idea
static/docs_index/
node_modules/
node_modules/*
_vendor/
__pycache__/

# Pre-rendered VQL code-fence HTML, generated by scripts/vql_highlight
# (make vql_highlight).
generated/vql/
scripts/vql_highlight/vql_highlight
